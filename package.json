{
  "name": "cultivation-life",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win --x64 --publish never",
    "test:desktop": "npm run build && node tools/test-desktop.cjs",
    "dev:music": "vite --host 127.0.0.1 --port 5191 --strictPort --mode local-music"
  },
  "dependencies": {
    "pinia": "^3.0.3",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.1.1"
  },
  "main": "desktop/main.cjs",
  "description": "修仙人生：本地单机修仙叙事试玩版",
  "author": "XXRS"
}
